# Copy to `.env` (git-ignored) and fill in. R2E loads `.env` automatically.

# Public origin of the tunnel, and its bare hostname.
MCP_PUBLIC_URL=https://your-tunnel.ngrok-free.dev
MCP_PUBLIC_HOST=your-tunnel.ngrok-free.dev

# OIDC issuer and the pre-created PUBLIC client the DCR shim hands out.
MCP_ISSUER=https://id.example.com/realms/acme
MCP_CLIENT_ID=mcp-public

# `skip` until the IdP stamps the resource URI into `aud`; then `resource`.
MCP_AUDIENCE_MODE=skip
